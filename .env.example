# LLM provider — OpenAI-compatible client, provider switched by config, not code (Decision 3).
# Dev = DeepSeek, delivery = OpenAI. Consumed by agent/client.py (the only module that knows
# providers exist).
#
# Keys are PER PROVIDER, so both can live here at once and switching provider is a single
# variable rather than a key swap. LLM_PROVIDER defaults to deepseek when unset.
DEEPSEEK_API_KEY=your-deepseek-key
OPENAI_API_KEY=your-openai-key

# LLM_PROVIDER=deepseek    # deepseek (default) | openai
# LLM_BASE_URL=            # optional override; defaults per provider
# LLM_MODEL=               # optional override; defaults per provider
# LLM_REASONING_EFFORT=    # reasoning models pin to "none" automatically; "unset" suppresses
